<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cq</groupId>
        <artifactId>code-quality-analyzer</artifactId>
        <version>2.0.0</version>
    </parent>
    <artifactId>cq-parser</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 依赖公共模块（AST 摘要 Schema） -->
        <dependency>
            <groupId>com.cq</groupId>
            <artifactId>cq-common</artifactId>
            <version>2.0.0</version>
        </dependency>
        <!-- JavaParser 核心依赖，版本由父 POM 统一管理 -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>
        <!--
            JSON / YAML 良构校验：只用来判断配置文件写得对不对，不做 AST 解析。
            版本由 spring-boot-dependencies 统一管理，无需指定。
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <!-- 日志 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- 单元测试（版本由 spring-boot-starter-parent 的 junit-bom 统一管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- spring-boot-starter-parent 默认绑定旧版 surefire，需显式升级才能跑 JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
