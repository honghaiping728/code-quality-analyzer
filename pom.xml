<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.4</version>
        <relativePath/>
    </parent>
    <groupId>com.cq</groupId>
    <artifactId>code-quality-analyzer</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <javaparser.version>3.26.4</javaparser.version>
        <jgit.version>6.10.0.202406032230-r</jgit.version>
        <!-- MyBatis-Plus：版本不在 Spring Boot 依赖管理中，需显式指定 -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <!-- MySQL 驱动版本由 spring-boot-dependencies 统一管理，无需指定 -->
        <!-- 前端构建：由 frontend-maven-plugin 自带 Node，构建机无需预装 -->
        <frontend-maven-plugin.version>1.15.4</frontend-maven-plugin.version>
        <!-- 必须带前导 v：插件拿 node 的版本输出做等值比较，漏掉 v 会导致每次构建都重新下载 Node -->
        <node.version>v22.14.0</node.version>
        <!-- 只跑后端时：mvn test -Dskip.frontend -->
        <skip.frontend>false</skip.frontend>
    </properties>
    <modules>
        <module>cq-common</module>
        <module>cq-repo</module>
        <module>cq-scan</module>
        <module>cq-parser</module>
        <module>cq-rule</module>
        <module>cq-agent</module>
        <module>cq-suggestion</module>
        <module>cq-report</module>
        <module>cq-admin</module>
        <module>cq-web</module>
    </modules>
</project>
