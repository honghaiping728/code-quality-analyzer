<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cq</groupId>
        <artifactId>code-quality-analyzer</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>cq-scan</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 公共 Schema -->
        <dependency>
            <groupId>com.cq</groupId>
            <artifactId>cq-common</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- 扫描编排需要：解析器 + 规则引擎 + 仓库接入 -->
        <dependency>
            <groupId>com.cq</groupId>
            <artifactId>cq-parser</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.cq</groupId>
            <artifactId>cq-rule</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.cq</groupId>
            <artifactId>cq-repo</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- Spring 容器能力（@Service 等），但不引入 web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 持久化 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
